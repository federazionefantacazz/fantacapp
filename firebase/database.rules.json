{
  "rules": {
    "teams": {
      ".read": true,
      ".write": "auth != null && (root.child('users/' + auth.uid + '/status').val() === 'approved' || root.child('users/' + auth.uid + '/role').val() === 'patron')"
    },
    "players": {
      ".read": true,
      ".write": "auth != null && (root.child('users/' + auth.uid + '/status').val() === 'approved' || root.child('users/' + auth.uid + '/role').val() === 'patron')"
    },
    "trades": {
      ".read": true,
      ".write": "auth != null && (root.child('users/' + auth.uid + '/status').val() === 'approved' || root.child('users/' + auth.uid + '/role').val() === 'patron')"
    },
    "competitions": {
      ".read": true,
      ".write": "auth != null && (root.child('users/' + auth.uid + '/status').val() === 'approved' || root.child('users/' + auth.uid + '/role').val() === 'patron')"
    },
    "notifications": {
      ".read": true,
      ".write": "auth != null && (root.child('users/' + auth.uid + '/status').val() === 'approved' || root.child('users/' + auth.uid + '/role').val() === 'patron')",
      ".indexOn": [
        "createdAt"
      ]
    },
    "notificationTemplates": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "votes": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "trophies": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "status": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "kitAssets": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "statsMeta": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "playerStats": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "probabili": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "liveMatches": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'"
    },
    "meta": {
      ".read": true,
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'",
      "patronExists": {
        ".write": "auth != null && newData.val() === true"
      }
    },
    "users": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'",
        "email": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "createdAt": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "status": {
          ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.val() === 'pending') || (newData.val() === 'approved' && root.child('meta/patronExists').val() !== true))"
        },
        "role": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === 'patron' && root.child('meta/patronExists').val() !== true"
        }
      }
    },
    "accountRequests": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'",
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "settings": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'",
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'patron'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
